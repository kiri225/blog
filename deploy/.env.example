# 对外端口（供 1Panel / Nginx 反代）
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMIN_PORT=8848

# 管理后台一键部署（挂载 docker.sock 后启用）
DEPLOY_ENABLED=1

# ---------- 后端 FastAPI ----------
DATABASE_URL=postgresql+psycopg://user:password@host:5432/blog
SECRET_KEY=change-me-to-a-long-random-string

# 生产域名（逗号分隔，含前台与管理后台）
CORS_ORIGINS=https://boke.hiromu.top,http://boke.hiromu.top

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_ORIGIN=https://boke.hiromu.top
DEV_FAKE_GITHUB=

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=
